{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands + event listening only. No fs/shell/http to the renderer.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-app-status",
    "allow-retry-storage",
    "allow-save-key",
    "allow-delete-key",
    "allow-test-connection",
    "allow-audio-devices",
    "allow-mic-test-start",
    "allow-mic-test-stop",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-pricing",
    "allow-cost-estimate",
    "allow-create-session",
    "allow-start-session",
    "allow-resume-session",
    "allow-pause-session",
    "allow-stop-session",
    "allow-set-mute",
    "allow-send-text",
    "allow-next-question",
    "allow-switch-input",
    "allow-live-snapshot",
    "allow-list-sessions",
    "allow-get-session",
    "allow-canvas-definition",
    "allow-edit-item",
    "allow-confirm-step",
    "allow-add-action",
    "allow-delete-note",
    "allow-correct-turn",
    "allow-rename-session",
    "allow-delete-session",
    "allow-cost-overview",
    "allow-export-session",
    "allow-export-costs",
    "allow-export-diagnostics"
  ]
}
